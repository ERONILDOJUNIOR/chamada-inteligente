# ============================================
# CONFIGURAÇÃO DO GOOGLE SHEETS API
# ============================================

# E-mail da Service Account (encontrado no JSON de credenciais)
GOOGLE_SERVICE_ACCOUNT_EMAIL=sua-conta@seu-projeto.iam.gserviceaccount.com

# Chave privada da Service Account (copie do JSON, mantenha as aspas)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_AQUI\n-----END PRIVATE KEY-----\n"

# ID da planilha (string na URL entre /d/ e /edit)
SPREADSHEET_ID=1abc123def456_exemplo

# ============================================
# CONFIGURAÇÃO DO SERVIDOR
# ============================================
PORT=3000

# Nome da aba padrão na planilha (a aba que será selecionada automaticamente)
DEFAULT_SHEET_NAME=CHAMADA *

# Código de acesso para entrar no sistema
ACCESS_CODE=test